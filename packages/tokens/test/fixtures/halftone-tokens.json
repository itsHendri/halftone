        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
