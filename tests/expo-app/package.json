{
  "$comment": "The native kit installed in a plain Expo + NativeWind + react-native-reusables app, as an app outside the kit would (scripts/expo-app-check.mjs). Not a workspace: it installs on its own. Expo packages are on the kit's SDK ranges; `npx expo install --fix` settles them.",
  "name": "halftone-expo-app-check",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@rn-primitives/portal": "~1.4.0",
    "expo": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-constants": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.3"
  }
}
