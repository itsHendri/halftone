{
  "name": "halftone",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsHendri/halftone.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mobile --",
    "ios": "npm run ios -w apps/mobile --",
    "web": "npm run web -w apps/mobile --",
    "typecheck": "npm run typecheck -w apps/mobile --",
    "lint": "npm run lint -w apps/mobile --",
    "check": "npm run typecheck -w apps/mobile && npm run lint -w apps/mobile -- --max-warnings 0 && npm run tokens:check -w apps/mobile && npm run registry:build -w apps/mobile -- --check && npm run typecheck -w apps/web && npm run lint -w apps/web && npm run tokens:check -w apps/web && npm run registry:build -w apps/web -- --check && npm run tokens:sync -- --check && npm test -w packages/tokens && npm run typecheck -w apps/docs",
    "test": "npm test -w packages/tokens",
    "docs:dev": "npm run dev -w apps/docs",
    "docs:build": "npm run build -w apps/docs",
    "docs:preview": "npm run preview -w apps/docs",
    "web:dev": "npm run dev -w apps/web",
    "tokens:sync": "node scripts/tokens-sync.mjs",
    "theme": "npm exec -w apps/mobile -- kit-tokens theme",
    "theme:apply": "node scripts/theme-apply.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "tailwindcss": "^3.4.14"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
