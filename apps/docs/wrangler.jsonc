// Cloudflare Workers, static assets only: no Worker script, so no request or CPU quotas apply.
// Build: `npm run build` (writes out/). Deploy: `npx wrangler deploy`. Preview: `npm run preview`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "halftone-docs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Branch previews (Workers Builds runs `wrangler preview` for non-main branches). Empty on purpose:
  // previews reuse the assets settings above.
  "previews": {}
}
