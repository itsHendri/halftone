{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/../mobile/.claude/hooks/lint-edited.mjs\" --app \"$CLAUDE_PROJECT_DIR\" --dirs app,components,lib", "timeout": 60 }
        ]
      }
    ]
  }
}
