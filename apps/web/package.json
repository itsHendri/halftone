{
  "name": "halftone-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsHendri/halftone.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:rules": "node --test eslint/*.test.mjs",
    "tokens:build": "halftone-tokens build",
    "tokens:check": "halftone-tokens check",
    "theme": "halftone-tokens theme",
    "tokens:figma": "halftone-tokens figma",
    "registry:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/registry-build.mjs",
    "registry:drift": "node scripts/shadcn-drift.mjs",
    "registry:dist": "npx -y shadcn@4.21.3 build registry.json --output dist/r/web",
    "registry:roundtrip": "node scripts/registry-roundtrip.mjs",
    "eject-samples": "node scripts/eject-samples.mjs",
    "setup": "node scripts/setup.mjs",
    "qc:look": "node scripts/qc-look.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@halftone-ds/tokens": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  }
}
