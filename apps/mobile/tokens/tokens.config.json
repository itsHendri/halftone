{
  "$description": "What `npm run tokens:build` writes, and where. Paths are relative to the app root. Targets are the files in @halftone-ds/tokens/targets (nativewind3, ts-theme, fonts, figma, shadcn-web, registry-theme, design-md, llms).",
  "source": "tokens/tokens.json",
  "scan": [
    "app",
    "components"
  ],
  "targets": {
    "nativewind3": {
      "css": "tokens/generated/tokens.css",
      "partial": true,
      "preset": "tokens/generated/tailwind.preset.js"
    },
    "ts-theme": {
      "out": "lib/theme.ts",
      "navTheme": "expo-router/react-navigation"
    },
    "figma": {
      "out": "tokens/generated/figma-theme.mjs"
    },
    "shadcn-web": {
      "out": "tokens/generated/web.css"
    },
    "registry-theme": {
      "out": "tokens/generated/theme.registry.json"
    },
    "design-md": {
      "out": "DESIGN.md",
      "name": "Halftone"
    },
    "llms": {
      "out": "tokens/generated/llms-tokens.md"
    },
    "fonts": {
      "platform": "expo",
      "out": "lib/fonts.ts"
    }
  }
}
